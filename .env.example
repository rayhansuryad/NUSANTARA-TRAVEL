# Copy this file to .env and fill in the values. Never commit .env.

# --- Midtrans ---------------------------------------------------------------
# Sandbox:    https://api.sandbox.midtrans.com   key starts with SB-Mid-server-
# Production: https://api.midtrans.com           key starts with Mid-server-
# The server refuses to start when the key prefix and the environment disagree,
# because that mistake is silent and wastes an afternoon.
MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=SB-Mid-server-REPLACE_ME

# Which bank the virtual account belongs to. One of bca, bni, bri, permata.
# These four share one request shape. Mandiri needs the separate echannel shape
# and is not wired up yet, so the server refuses to start with MIDTRANS_BANK=mandiri.
MIDTRANS_BANK=bca

# How long a virtual account or QR code stays payable.
MIDTRANS_EXPIRY_HOURS=24

# --- Balance collection -----------------------------------------------------
# A deposit booking owes the rest. This is how many days before departure the
# second virtual account is raised for it. The scheduled job runs from
# /api/cron/reconcile.
BALANCE_LEAD_DAYS=14

# Where to send the "your balance is due" message. Any endpoint that accepts a
# JSON POST works (Resend, Zapier, Make, a route of your own). With no URL set
# the message is logged in full for a person to send by hand, which is the
# honest default rather than silently creating an account nobody is told about.
# BALANCE_NOTIFY_URL=https://api.resend.com/emails

# Used to build a link back to the booking in that message. Optional.
# PUBLIC_BASE_URL=https://your-domain.example

# Point this at a local mock to test without a Midtrans account.
# Leave it unset in production.
# MIDTRANS_API_BASE=http://127.0.0.1:8790

# --- Database ---------------------------------------------------------------
# Set this in production (Neon, Supabase, Railway, and so on). Leave it unset
# to fall back to a local SQLite file at .data/bookings.db.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Set to "off" only when your Postgres does not use TLS.
# DATABASE_SSL=off

# --- Reconcile cron ---------------------------------------------------------
# Protects /api/cron/reconcile. Generate with: node -e "console.log(crypto.randomUUID())"
CRON_SECRET=REPLACE_ME

# --- Local dev only ---------------------------------------------------------
# Port for server/dev.js. The mock gateway listens on PORT + 1.
PORT=8787
